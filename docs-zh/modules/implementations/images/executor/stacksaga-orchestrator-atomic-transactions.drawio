          <mxGeometry x="155" y="48" width="135" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc_exec3" value="Authorizes credit card charge&lt;br/&gt;Revert voids / refunds transaction" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9.5;fontColor=#64748B;" vertex="1" parent="box_exec3">
          <mxGeometry x="300" y="48" width="220" height="34" as="geometry" />
        </mxCell>

        <!-- Executor 4: Command Inventory -->
        <mxCell id="box_exec4" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="orch_container">
          <mxGeometry x="20" y="365" width="530" height="98" as="geometry" />
        </mxCell>
        <mxCell id="lbl_exec4" value="&lt;b style='font-size:12px;color:#1E40AF;'&gt;ReserveStockCommandExecutor&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#2563EB;'&gt;CommandExecutor&amp;lt;OrderAggregate&amp;gt;&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="box_exec4">
          <mxGeometry x="12" y="8" width="260" height="35" as="geometry" />
        </mxCell>
        <mxCell id="btn_exec4_proc" value="doProcess() ➔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#15803D;fontColor=#FFFFFF;fontStyle=1;fontSize=10.5;" vertex="1" parent="box_exec4">
          <mxGeometry x="12" y="48" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="btn_exec4_rev" value="⬅ doRevert()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#B91C1C;fontColor=#FFFFFF;fontStyle=1;fontSize=10.5;" vertex="1" parent="box_exec4">
          <mxGeometry x="155" y="48" width="135" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc_exec4" value="Deducts stock in warehouse&lt;br/&gt;Revert restores stock units" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9.5;fontColor=#64748B;" vertex="1" parent="box_exec4">
          <mxGeometry x="300" y="48" width="220" height="34" as="geometry" />
        </mxCell>

        <!-- Right Side: 4 Target Microservices -->
        <mxCell id="target1" value="&lt;b style='color:#1E293B;'&gt;User Service&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;User DB (PostgreSQL)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="125" width="290" height="75" as="geometry" />
        </mxCell>

        <mxCell id="target2" value="&lt;b style='color:#1E293B;'&gt;Order Service (Local DB)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Order DB (PostgreSQL ACID)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="235" width="290" height="75" as="geometry" />
        </mxCell>

        <mxCell id="target3" value="&lt;b style='color:#1E293B;'&gt;Payment Service / Gateway&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Stripe / Bank REST API&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="345" width="290" height="75" as="geometry" />
        </mxCell>

        <mxCell id="target4" value="&lt;b style='color:#1E293B;'&gt;Inventory Service&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:9.5px;color:#64748B;'&gt;Warehouse DB (MySQL)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="840" y="455" width="290" height="75" as="geometry" />
        </mxCell>

        <!-- Forward & Revert Connectors -->
        <!-- 1 -> Target 1 (Forward Only) -->
        <mxCell id="edge1_fwd" value="doProcess(): GET /users/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16A34A;strokeWidth=2;endArrow=classic;fontSize=9.5;fontColor=#15803D;" edge="1" parent="1" source="btn_exec1_proc" target="target1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 2 -> Target 2 (Forward & Revert) -->
        <mxCell id="edge2_fwd" value="doProcess(): saveOrder()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16A34A;strokeWidth=2;endArrow=classic;fontSize=9.5;fontColor=#15803D;" edge="1" parent="1" source="btn_exec2_proc" target="target2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="710" y="278" /><mxPoint x="710" y="255" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge2_rev" value="doRevert(): cancelOrder()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;strokeWidth=1.8;strokeDashed=1;endArrow=classic;fontSize=9.5;fontColor=#DC2626;" edge="1" parent="1" source="btn_exec2_rev" target="target2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="730" y="288" /><mxPoint x="730" y="290" /></Array>
          </mxGeometry>
        </mxCell>

        <!-- 3 -> Target 3 (Forward & Revert) -->
        <mxCell id="edge3_fwd" value="doProcess(): POST /charge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#16A34A;strokeWidth=2;endArrow=classic;fontSize=9.5;fontColor=#15803D;" edge="1" parent="1" source="btn_exec3_proc" target="target3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="710" y="388" /><mxPoint x="710" y="365" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge3_rev" value="doRevert(): POST /refund" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;strokeWidth=1.8;strokeDashed=1;endArrow=classic;fontSize=9.5;fontColor=#DC2626;" edge="1" parent="1" source="btn_exec3_rev" target="target3">
          <mxGeometry relative="1" as="geometry">
