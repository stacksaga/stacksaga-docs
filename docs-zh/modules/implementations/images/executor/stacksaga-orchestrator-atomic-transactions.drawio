<mxfile host="app.diagrams.net" agent="draw.io" version="24.4.0" type="device">
  <diagram id="stacksaga-orchestrator-atomic-transactions" name="orchestrator-atomic-transactions">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="600" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Master Title -->
        <mxCell id="title" value="&lt;b style='font-size:15px;color:#0F172A;'&gt;Saga Orchestrator Service &amp;amp; Atomic Transaction Boundaries&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:11px;color:#475569;'&gt;Order Service Orchestrator hosting 4 discrete executors executing doProcess() and doRevert() against target microservices&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="1120" height="48" as="geometry" />
        </mxCell>

        <!-- Big Container: Order Service (Orchestrator) -->
        <mxCell id="orch_container" value="&lt;b style='font-size:13px;color:#1E293B;'&gt;Order Service Application (Saga Orchestrator)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="570" height="485" as="geometry" />
        </mxCell>

        <!-- Executor 1: Query -->
        <mxCell id="box_exec1" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="orch_container">
          <mxGeometry x="20" y="40" width="530" height="92" as="geometry" />
        </mxCell>
        <mxCell id="lbl_exec1" value="&lt;b style='font-size:12px;color:#15803D;'&gt;CheckCustomerEligibilityExecutor&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#166534;'&gt;QueryExecutor&amp;lt;OrderAggregate&amp;gt;&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="box_exec1">
          <mxGeometry x="12" y="8" width="260" height="35" as="geometry" />
        </mxCell>
        <mxCell id="btn_exec1_proc" value="doProcess() ➔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#15803D;fontColor=#FFFFFF;fontStyle=1;fontSize=10.5;" vertex="1" parent="box_exec1">
          <mxGeometry x="12" y="48" width="130" height="32" as="geometry" />
        </mxCell>
        <mxCell id="btn_exec1_rev" value="[ doRevert: Skipped ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeDashed=1;fontColor=#94A3B8;fontSize=9.5;" vertex="1" parent="box_exec1">
          <mxGeometry x="155" y="48" width="135" height="32" as="geometry" />
        </mxCell>
        <mxCell id="desc_exec1" value="Read-only query: Checks customer status &amp;amp; credit limit" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9.5;fontColor=#64748B;" vertex="1" parent="box_exec1">
          <mxGeometry x="300" y="48" width="220" height="32" as="geometry" />
        </mxCell>

        <!-- Executor 2: Command Order -->
        <mxCell id="box_exec2" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="orch_container">
          <mxGeometry x="20" y="145" width="530" height="98" as="geometry" />
        </mxCell>
        <mxCell id="lbl_exec2" value="&lt;b style='font-size:12px;color:#1E40AF;'&gt;CreateOrderCommandExecutor&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#2563EB;'&gt;CommandExecutor&amp;lt;OrderAggregate&amp;gt;&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="box_exec2">
          <mxGeometry x="12" y="8" width="260" height="35" as="geometry" />
        </mxCell>
        <mxCell id="btn_exec2_proc" value="doProcess() ➔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#15803D;fontColor=#FFFFFF;fontStyle=1;fontSize=10.5;" vertex="1" parent="box_exec2">
          <mxGeometry x="12" y="48" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="btn_exec2_rev" value="⬅ doRevert()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#B91C1C;fontColor=#FFFFFF;fontStyle=1;fontSize=10.5;" vertex="1" parent="box_exec2">
          <mxGeometry x="155" y="48" width="135" height="34" as="geometry" />
        </mxCell>
        <mxCell id="desc_exec2" value="Persists order (PENDING)&lt;br/&gt;Revert cancels order in DB" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9.5;fontColor=#64748B;" vertex="1" parent="box_exec2">
          <mxGeometry x="300" y="48" width="220" height="34" as="geometry" />
        </mxCell>

        <!-- Executor 3: Command Payment -->
        <mxCell id="box_exec3" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="orch_container">
          <mxGeometry x="20" y="255" width="530" height="98" as="geometry" />
        </mxCell>
        <mxCell id="lbl_exec3" value="&lt;b style='font-size:12px;color:#1E40AF;'&gt;ProcessPaymentCommandExecutor&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:10px;color:#2563EB;'&gt;CommandExecutor&amp;lt;OrderAggregate&amp;gt;&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="box_exec3">
