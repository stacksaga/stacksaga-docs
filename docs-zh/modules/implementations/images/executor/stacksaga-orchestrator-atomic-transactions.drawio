        <mxCell id="btn_exec3_proc" value="doProcess() ➔" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16A34A;strokeColor=#15803D;fontColor=#FFFFFF;fontStyle=1;fontSize=10.5;" vertex="1" parent="box_exec3">
