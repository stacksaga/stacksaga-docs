        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "stacksaga_r2dbc_pool_idle{service=~\"$service\", cluster=~\"$cluster\"}",
          "legendFormat": "Idle",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "stacksaga_r2dbc_pool_pending{service=~\"$service\", cluster=~\"$cluster\"}",
          "legendFormat": "Pending (Waiting)",
          "refId": "D"
        }
