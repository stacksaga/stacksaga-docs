          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "stacksaga_scheduler_tasks_active_seconds_count{scheduler=\"saga-bl-exe\", service=~\"$service\", cluster=~\"$cluster\"}",
          "legendFormat": "Blocking Executor Tasks Active",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "stacksaga_retry_inflight{service=~\"$service\", cluster=~\"$cluster\"}",
          "legendFormat": "Retry Tasks In-flight",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "stacksaga_scheduler_tasks_pending_seconds_count{scheduler=\"saga-exe\", service=~\"$service\", cluster=~\"$cluster\"}",
