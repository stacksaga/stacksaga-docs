          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "stacksaga_r2dbc_pool_acquired{service=~\"$service\", cluster=~\"$cluster\"}",
          "legendFormat": "Acquired (In Use)",
