        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "stacksaga_scheduler_tasks_pending_seconds_count{scheduler=\"saga-bl-exe\", service=~\"$service\", cluster=~\"$cluster\"}",
