<diagram id="destination-bridge" name="DESTINATION-BRIDGE"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="380" background="#ffffff" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><!-- Title --><mxCell id="b-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 15px; color: #0f172a;&quot;&gt;UNDERSTANDING THE 'DESTINATION': THE BRIDGE TO USNP&lt;/b&gt;&lt;div style=&quot;font-size: 11px; color: #64748b; margin-top: 2px;&quot;&gt;How Execution (USEP) Hands Off Control to Workflow Navigation (USNP)&lt;/div&gt;" vertex="1"><mxGeometry height="38" width="550" x="145" y="12" as="geometry" /></mxCell><!-- ==================== LEFT: PILLAR 1 (USEP) ==================== --><mxCell id="b-p1-box" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=1.5;fontFamily=Helvetica;" value="" vertex="1"><mxGeometry height="280" width="310" x="35" y="65" as="geometry" /></mxCell><!-- USEP Header --><mxCell id="b-p1-hdr" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size: 11px; font-weight: bold; color: #1e40af;&quot;&gt;PILLAR 1: USEP&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: bold; color: #0f172a;&quot;&gt;Step Execution Domain&lt;/div&gt;" vertex="1"><mxGeometry height="42" width="280" x="50" y="75" as="geometry" /></mxCell><!-- Step 1: Execution Action --><mxCell id="b-step1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 11px; color: #0f172a;&quot;&gt;1. Atomic Step Execution&lt;/b&gt;&lt;div style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Call DB, REST API, or Kafka Topic&lt;/div&gt;" vertex="1"><mxGeometry height="38" width="260" x="60" y="130" as="geometry" /></mxCell><!-- Arrow Step 1 to Step 2 --><mxCell id="b-arrow1" edge="1" parent="1" source="b-step1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;" target="b-step2"><mxGeometry relative="1" as="geometry" /></mxCell><!-- Step 2: Event Store Commitment --><mxCell id="b-step2" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 11px; color: #0f172a;&quot;&gt;2. Event Store Persistence&lt;/b&gt;&lt;div style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Snapshot &amp;amp; Step Event Safely Saved&lt;/div&gt;" vertex="1"><mxGeometry height="38" width="260" x="60" y="195" as="geometry" /></mxCell><!-- Arrow Step 2 to Destination --><mxCell id="b-arrow2" edge="1" parent="1" source="b-step2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;" target="b-dest"><mxGeometry relative="1" as="geometry" /></mxCell><!-- Destination (The Threshold) --><mxCell id="b-dest" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 3;fillColor=#fef9c3;strokeColor=#ca8a04;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 12px; color: #854d0e;&quot;&gt;[ Destination ]&lt;/b&gt;&lt;div style=&quot;font-size: 10px; color: #a16207;&quot;&gt;Abstract Handoff Threshold&lt;/div&gt;" vertex="1"><mxGeometry height="42" width="220" x="80" y="260" as="geometry" /></mxCell><!-- ==================== BRIDGE CONNECTOR ==================== --><mxCell id="b-bridge-arrow" edge="1" parent="1" source="b-dest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;endArrow=block;endFill=1;" target="b-p2-fork"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="281" /><mxPoint x="380" y="205" /></Array></mxGeometry></mxCell><!-- Bridge Label --><mxCell id="b-bridge-label" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size: 10px; color: #1e40af;&quot;&gt;Handoff Control&lt;/b&gt;&lt;div style=&quot;font-size: 9px; color: #3b82f6;&quot;&gt;USNP Resolves Target&lt;/div&gt;" vertex="1"><mxGeometry height="30" width="115" x="325" y="190" as="geometry" /></mxCell><!-- ==================== RIGHT: PILLAR 2 (USNP) ==================== --><mxCell id="b-p2-box" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#7c3aed;strokeWidth=1.5;fontFamily=Helvetica;" value="" vertex="1"><mxGeometry height="280" width="370" x="420" y="65" as="geometry" /></mxCell><!-- USNP Header --><mxCell id="b-p2-hdr" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size: 11px; font-weight: bold; color: #6b21a8;&quot;&gt;PILLAR 2: USNP&lt;/div&gt;&lt;div style=&quot;font-size: 12px; font-weight: bold; color: #0f172a;&quot;&gt;Workflow Navigation Domain (Concrete Targets)&lt;/div&gt;" vertex="1"><mxGeometry height="42" width="340" x="435" y="75" as="geometry" /></mxCell><!-- Virtual Fork Entry Node --><mxCell id="b-p2-fork" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#7c3aed;strokeColor=none;" value="" vertex="1"><mxGeometry height="10" width="10" x="450" y="200" as="geometry" /></mxCell><!-- Target Option 1: CommandExecutor --><mxCell id="b-opt1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;Route to CommandExecutor&lt;/b&gt;&lt;div style=&quot;font-size: 9.5px; color: #64748b; font-family: monospace;&quot;&gt;.toNextExecutor(NextCommand.class)&lt;/div&gt;" vertex="1"><mxGeometry height="36" width="270" x="500" y="126" as="geometry" /></mxCell><mxCell id="b-conn1" edge="1" parent="1" source="b-p2-fork" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b-opt1"><mxGeometry relative="1" as="geometry" /></mxCell><!-- Target Option 2: QueryExecutor --><mxCell id="b-opt2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;Route to QueryExecutor&lt;/b&gt;&lt;div style=&quot;font-size: 9.5px; color: #64748b; font-family: monospace;&quot;&gt;.toNextExecutor(CalculateTaxQuery.class)&lt;/div&gt;" vertex="1"><mxGeometry height="36" width="270" x="500" y="168" as="geometry" /></mxCell><mxCell id="b-conn2" edge="1" parent="1" source="b-p2-fork" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b-opt2"><mxGeometry relative="1" as="geometry" /></mxCell><!-- Target Option 3: Dynamic Branching --><mxCell id="b-opt3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;Dynamic Conditional Branching&lt;/b&gt;&lt;div style=&quot;font-size: 9.5px; color: #64748b; font-family: monospace;&quot;&gt;.toNextExecutor(isVip ? Air.class : Ground.class)&lt;/div&gt;" vertex="1"><mxGeometry height="36" width="270" x="500" y="210" as="geometry" /></mxCell><mxCell id="b-conn3" edge="1" parent="1" source="b-p2-fork" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b-opt3"><mxGeometry relative="1" as="geometry" /></mxCell><!-- Target Option 4: Terminal Complete --><mxCell id="b-opt4" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;Terminal Workflow Completion&lt;/b&gt;&lt;div style=&quot;font-size: 9.5px; color: #64748b; font-family: monospace;&quot;&gt;.complete() or .resumeToComplete()&lt;/div&gt;" vertex="1"><mxGeometry height="36" width="270" x="500" y="252" as="geometry" /></mxCell><mxCell id="b-conn4" edge="1" parent="1" source="b-p2-fork" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b-opt4"><mxGeometry relative="1" as="geometry" /></mxCell><!-- Target Option 5: Automatic Rollback --><mxCell id="b-opt5" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=8;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;Deterministic Reverse Autopilot&lt;/b&gt;&lt;div style=&quot;font-size: 9.5px; color: #64748b; font-family: monospace;&quot;&gt;.resumeToNextDefaultExecutor()&lt;/div&gt;" vertex="1"><mxGeometry height="36" width="270" x="500" y="294" as="geometry" /></mxCell><mxCell id="b-conn5" edge="1" parent="1" source="b-p2-fork" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7c3aed;strokeWidth=1.2;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="b-opt5"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram>
