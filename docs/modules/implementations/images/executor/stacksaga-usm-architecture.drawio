        <mxCell id="u-p1-box" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=1.5;fontFamily=Helvetica;" value="" vertex="1">
