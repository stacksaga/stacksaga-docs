        <mxCell id="u-p2-hdr" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size: 11px; font-weight: bold; letter-spacing: 0.5px; color: #6b21a8;&quot;&gt;PILLAR 2: WORKFLOW NAVIGATION&lt;/div&gt;&lt;div style=&quot;font-size: 13px; font-weight: bold; color: #0f172a; margin-top: 2px;&quot;&gt;Unified Saga Navigation Patterns (USNP)&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Workflow Graph Routing &amp;amp; Compensation&lt;/div&gt;" vertex="1">
