        <mxCell id="u-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 15px; color: #0f172a;&quot;&gt;THE SAGA ORCHESTRATION ENGINE ARCHITECTURE&lt;/b&gt;&lt;div style=&quot;font-size: 11px; color: #64748b; margin-top: 2px;&quot;&gt;Unified Saga Model (USM): The Two Foundational Pillars&lt;/div&gt;" vertex="1">
