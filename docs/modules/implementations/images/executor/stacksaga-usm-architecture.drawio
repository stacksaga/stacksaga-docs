        <mxCell id="u-p1-hdr" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size: 11px; font-weight: bold; letter-spacing: 0.5px; color: #1e40af;&quot;&gt;PILLAR 1: STEP EXECUTION&lt;/div&gt;&lt;div style=&quot;font-size: 13px; font-weight: bold; color: #0f172a; margin-top: 2px;&quot;&gt;Unified Saga Execution Patterns (USEP)&lt;/div&gt;&lt;div style=&quot;font-size: 10px; color: #64748b;&quot;&gt;Step Execution &amp;amp; Commit Timing&lt;/div&gt;" vertex="1">
          <mxGeometry height="52" width="310" x="65" y="195" as="geometry" />
        </mxCell>
        <mxCell id="u-p1-i1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;1. Direct Synchronous&lt;/b&gt; &lt;span style=&quot;color: #2563eb; font-size: 10px;&quot;&gt;(Sync-Continuous)&lt;/span&gt;&lt;div style=&quot;font-size: 10px; color: #64748b; margin-top: 1px;&quot;&gt;Inline in-thread request/response • Lowest latency&lt;/div&gt;" vertex="1">
          <mxGeometry height="42" width="310" x="65" y="257" as="geometry" />
        </mxCell>
        <mxCell id="u-p1-i2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;2. Correlated Park-and-Resume&lt;/b&gt; &lt;span style=&quot;color: #2563eb; font-size: 10px;&quot;&gt;(Sync-Paused)&lt;/span&gt;&lt;div style=&quot;font-size: 10px; color: #64748b; margin-top: 1px;&quot;&gt;&quot;Park and Wait&quot; liberates threads • Webhook / UI / Kafka&lt;/div&gt;" vertex="1">
          <mxGeometry height="42" width="310" x="65" y="307" as="geometry" />
        </mxCell>
        <mxCell id="u-p1-i3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;3. Two-Stage Lazy Dispatch&lt;/b&gt; &lt;span style=&quot;color: #2563eb; font-size: 10px;&quot;&gt;(Async-Paused)&lt;/span&gt;&lt;div style=&quot;font-size: 10px; color: #64748b; margin-top: 1px;&quot;&gt;Commit Barrier • Absolute immunity to race conditions&lt;/div&gt;" vertex="1">
          <mxGeometry height="42" width="310" x="65" y="357" as="geometry" />
        </mxCell>
        <mxCell id="u-p1-dest" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=none;fontFamily=Helvetica;verticalAlign=middle;" value="&lt;div style=&quot;font-size: 10px; color: #475569; text-align: center;&quot;&gt;Concludes at &lt;b style=&quot;color: #0f172a;&quot;&gt;[Destination]&lt;/b&gt; ➔ Hands off control to USNP&lt;/div&gt;" vertex="1">
