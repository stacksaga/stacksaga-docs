        <mxCell id="u-sec" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d0cee2;strokeColor=#56517e;strokeWidth=1.5;fontFamily=Helvetica;align=center;verticalAlign=middle;" value="&lt;div style=&quot;font-size: 13px; font-weight: bold; color: #1e1b4b;&quot;&gt;Saga Orchestration Engine&lt;/div&gt;&lt;div style=&quot;font-size: 11px; color: #475569; margin-top: 2px;&quot;&gt;Embedded Domain-Centric Coordinator (SEC)&lt;/div&gt;" vertex="1">
