        </mxCell>
        <mxCell id="u-p2-i1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;1. Forward Active &amp;amp; Dynamic Branching&lt;/b&gt;&lt;div style=&quot;font-size: 10px; color: #64748b; margin-top: 1px;&quot;&gt;ProcessStepManager • Command ➔ Command / Query&lt;/div&gt;" vertex="1">
          <mxGeometry height="38" width="310" x="475" y="253" as="geometry" />
        </mxCell>
        <mxCell id="u-p2-i2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;2. Deterministic Reverse Autopilot&lt;/b&gt;&lt;div style=&quot;font-size: 10px; color: #64748b; margin-top: 1px;&quot;&gt;RevertStepManager • Zero manual rollback routing (LIFO)&lt;/div&gt;" vertex="1">
          <mxGeometry height="38" width="310" x="475" y="297" as="geometry" />
        </mxCell>
        <mxCell id="u-p2-i3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1;fontFamily=Helvetica;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b style=&quot;color: #0f172a; font-size: 11px;&quot;&gt;3. 3-Phase Compensation Pipeline&lt;/b&gt;&lt;div style=&quot;font-size: 10px; color: #64748b; margin-top: 1px;&quot;&gt;PreExecutor ➔ Core doRevert() ➔ PostExecutor&lt;/div&gt;" vertex="1">
