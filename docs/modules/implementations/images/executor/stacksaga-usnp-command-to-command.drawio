entryDx=0;entryDy=0;strokeColor=#1e40af;strokeWidth=2;endArrow=block;endFill=1;" target="exec2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dest-handoff-lbl1" connectable="0" parent="dest-handoff-edge" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontColor=#1e40af;fontStyle=1;fontSize=9.5px;" value=".toNextExecutor(ReserveInventoryExecutor.class)" vertex="1"><mxGeometry relative="1" x="-0.05" y="-14" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="dest-handoff-lbl2" connectable="0" parent="dest-handoff-edge" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontColor=#64748b;fontSize=8.5px;" value="no park / no wait (continuous thread)" vertex="1"><mxGeometry relative="1" x="-0.05" y="14" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="exec2" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#36393d;strokeWidth=1.5;fontColor=#0f172a;" value="&lt;b style=&quot;font-size: 11.5px;&quot;&gt;CommandExecutor 2&lt;/b&gt;&lt;div style=&quot;font-size: 9.5px; color: #475569; margin-top: 2px;&quot;&gt;(ReserveInventoryExecutor)&lt;/div&gt;" vertex="1"><mxGeometry height="60" width="165" x="620" y="230" as="geometry" /></mxCell><mxCell id="es-bar" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=default;strokeWidth=1.5;fontColor=#0f172a;" value="" vertex="1"><mxGeometry height="24" width="940" x="80" y="365" as="geometry" /></mxCell><mxCell id="es-title" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11px;fontColor=#0f172a;align=left;verticalAlign=middle;" value="&lt;b&gt;event-store&lt;/b&gt;" vertex="1"><mxGeometry height="24" width="90" x="95" y="365" as="geometry" /></mxCell><mxCell id="es-evt1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" value="" vertex="1"><mxGeometry height="16" width="16" x="377" y="369" as="geometry" /></mxCell><mxCell id="sec1-es-edge" edge="1" parent="1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=2 3;strokeColor=#9673a6;strokeWidth=1.5;fillColor=#e1d5e7;"><mxGeometry relative="1" as="geometry"><mxPoint x="385" y="272.5" as="sourcePoint" /><mxPoint x="385" y="369" as="targetPoint" /></mxGeometry></mxCell><mxCell id="es-evt1-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8.5px;fontColor=#475569;" value="&lt;b&gt;ORDER_CREATED&lt;/b&gt;&lt;br&gt;(Compensable)" vertex="1"><mxGeometry height="25" width="120" x="325" y="393" as="geometry" /></mxCell><mxCell id="es-evt2-lbl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=8.5px;fontColor=#475569;" value="&lt;b&gt;INVENTORY_RESERVED&lt;/b&gt;&lt;br&gt;(Compensable)" vertex="1"><mxGeometry height="25" width="120" x="785" y="393" as="geometry" /></mxCell><mxCell id="summary-card" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;arcSize=3;align=left;spacingLeft=12;spacingRight=12;" value="&lt;b style=&quot;color: #0f172a; font-size: 10px;&quot;&gt;How Destination Works in Command-to-Command (Sync-Continuous):&lt;/b&gt;&lt;span style=&quot;font-size: 9.5px; color: #475569; margin-left: 6px;&quot;&gt;Once Command 1 commits its event, SEC immediately hands control over to the &lt;b style=&quot;color: #1e40af;&quot;&gt;Destination (CommandExecutor 2)&lt;/b&gt; in the exact same thread without pausing. Each Command Executor records its own independent event in the event-store for LIFO rollback.&lt;/span&gt;" vertex="1"><mxGeometry height="42" width="1010" x="45" y="445" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
