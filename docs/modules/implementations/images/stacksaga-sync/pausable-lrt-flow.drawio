              <mxPoint x="795" y="163" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Complete Terminal Badge -->
        <mxCell id="badge_complete" value="&lt;b&gt;COMPLETED&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;stepManager.complete()&lt;/font&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;strokeWidth=1.5;fontColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="143" width="90" height="40" as="geometry" />
        </mxCell>

        <mxCell id="edge_span3_complete" value="complete()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#059669;fontSize=8;" edge="1" parent="1" source="span3" target="badge_complete">
