        <!-- Step 3 -> Delivery Service -->
        <mxCell id="edge_call_delivery" value="3. Dispatch Order" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;dashed=1;fontColor=#475569;fontSize=9;" edge="1" parent="1" source="span3" target="ms_delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Summary Note at Bottom -->
        <mxCell id="summary_note" value="&lt;b&gt;Pausable Flow:&lt;/b&gt; Deliberate business wait state. The saga sleeps safely in the event store without holding CPU threads until the external webhook callback returns the correlation key (idempotencyKey) to resume execution." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#fde68a;strokeWidth=1;fontColor=#92400e;fontSize=11;align=center;" vertex="1" parent="1">
