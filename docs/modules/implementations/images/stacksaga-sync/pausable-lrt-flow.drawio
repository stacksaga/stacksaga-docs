        </mxCell>

        <!-- Step 2 -> Restaurant (Pass idempotencyKey) -->
        <mxCell id="edge_call_restaurant" value="1. Passes idempotencyKey" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;fontColor=#b45309;fontSize=9;" edge="1" parent="1" source="span2" target="ms_restaurant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Restaurant -> Callback Controller (Webhook callback) -->
        <mxCell id="edge_cb_restaurant" value="2. Callback: key = idempotencyKey" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;fontSize=9;" edge="1" parent="1" source="ms_restaurant" target="ctrl_callback">
