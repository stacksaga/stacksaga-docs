        <mxCell id="chip_c" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;align=left;spacingLeft=10;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 10px; color: #1E40AF;&quot;&gt;token(&#39;pod-order-c&#39;)&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 9px; color: #0F172A;&quot;&gt;= -1.29 × 10¹⁸ (Negative &amp;lt; 0)&lt;/b&gt;" vertex="1">
