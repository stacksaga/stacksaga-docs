        <mxCell id="stage3_box" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=55;spacingTop=10;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 13px; color: #1D4ED8;&quot;&gt;Deterministic Spatial Mapping (Tier 3: es_instances_by_retry_window)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;Cassandra CQL: instance_id_token = token(instance_id) • Uniform 64-bit Murmur3 Partition Space [-2⁶³ to 2⁶³-1]&lt;/span&gt;" vertex="1">
          <mxGeometry height="110" width="900" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="stage3_badge" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;" value="3" vertex="1">
