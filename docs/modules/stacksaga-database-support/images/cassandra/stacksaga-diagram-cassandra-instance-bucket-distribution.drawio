        <mxCell id="part_a" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1;align=left;spacingLeft=12;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 10px; color: #0F172A;&quot;&gt;Partition ((..., pod-order-a, 0))&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;14,210 rows • Size: ~1.1MB (&amp;lt; 5MB)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 8px; font-weight: 600; color: #065F46;&quot;&gt;Bucket 0 Active&lt;/span&gt;" vertex="1">
