        <mxCell id="pod_c" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1;align=center;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 11px; color: #0F172A;&quot;&gt;pod-order-c&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;font-size: 10px; color: #92400E;&quot;&gt;AtomicCounter: 3,420&lt;/span&gt;" vertex="1">
