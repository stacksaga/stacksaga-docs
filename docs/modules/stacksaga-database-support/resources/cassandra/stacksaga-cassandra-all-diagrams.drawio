        <!-- Title -->
        <mxCell id="title" value="Top-Down Traversal &amp;amp; Compaction Lifecycle Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="600" height="24" as="geometry" />
