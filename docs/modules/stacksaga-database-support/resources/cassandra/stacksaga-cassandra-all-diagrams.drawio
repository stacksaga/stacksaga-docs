        <mxCell id="card_1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.2;align=left;spacingLeft=38;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 11.5px; color: #065F46;&quot;&gt;Sealed Read Windows (≤ W)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;• Read by Retry-Nodes; zero row locks&lt;br/&gt;• Sweeps Retries (Even) &amp;amp; Watchdogs (Odd)&lt;/span&gt;" vertex="1">
          <mxGeometry height="66" width="275" x="40" y="260" as="geometry" />
        </mxCell>
        <mxCell id="badge_c1" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#059669;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;fontFamily=Helvetica;" value="2" vertex="1">
