        <!-- VC2: Slave-N -->
        <mxCell id="vc2_slaveN" value="&lt;b&gt;Slave-N&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#36393D;strokeWidth=1.3;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="695" y="206" width="140" height="44" as="geometry" />
        </mxCell>
        <!-- Dotted arrows Master -> Slaves -->
        <mxCell id="edge_vc2_m_s1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;dashed=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="vc2_master" target="vc2_slave1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_vc2_m_sN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.2;dashed=1;endArrow=classic;endFill=1;" edge="1" parent="1" source="vc2_master" target="vc2_slaveN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- VC2: Nodes Container -->
        <mxCell id="vc2_nodes_box" value="&lt;b style=&quot;font-size: 11.5px; color: #4A148C;&quot;&gt;Order-Service Orchestrator Pods (cluster-2)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673A6;strokeWidth=1.4;dashed=1;dashPattern=3 3;verticalAlign=top;align=center;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="523" y="270" width="410" height="258" as="geometry" />
        </mxCell>
        <!-- VC2: Standard-Nodes Subcontainer -->
        <mxCell id="vc2_std_box" value="&lt;b style=&quot;font-size: 10.5px; color: #56517E;&quot;&gt;Standard-Nodes (~9k)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 8.5px; color: #666666;&quot;&gt;Live Traffic • Writes Ahead (W+1)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#56517E;strokeWidth=1.2;dashed=1;dashPattern=3 3;verticalAlign=top;align=center;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="533" y="298" width="180" height="218" as="geometry" />
