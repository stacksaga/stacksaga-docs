        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" value="Instance-Level Local Bucketing &amp;amp; Autonomous Worker Re-Distribution" vertex="1">
          <mxGeometry height="24" width="700" x="40" y="22" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;fontFamily=Helvetica;" value="Lock-free failure ingestion by ephemeral pods decoupled from deterministic consumption by retry workers" vertex="1">
          <mxGeometry height="18" width="800" x="40" y="46" as="geometry" />
        </mxCell>
        <mxCell id="stage1_box" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=55;spacingTop=10;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 13px; color: #92400E;&quot;&gt;Thousands of Ephemeral Orchestrator Pods (Live Writers)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10.5px; color: #B45309;&quot;&gt;Independent local JVM atomic counters • Zero cross-instance communication • No shared database locks&lt;/span&gt;" vertex="1">
          <mxGeometry height="88" width="900" x="40" y="68" as="geometry" />
        </mxCell>
        <mxCell id="stage1_badge" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D97706;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=center;" value="1" vertex="1">
          <mxGeometry height="28" width="28" x="54" y="82" as="geometry" />
        </mxCell>
        <mxCell id="pod_a" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1;align=center;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 11px; color: #0F172A;&quot;&gt;pod-order-a&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;font-size: 10px; color: #92400E;&quot;&gt;AtomicCounter: 14,210&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="265" x="58" y="116" as="geometry" />
        </mxCell>
        <mxCell id="pod_b" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;strokeWidth=1.2;align=center;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 11px; color: #0F172A;&quot;&gt;pod-order-b&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;font-size: 10px; font-weight: 700; color: #D97706;&quot;&gt;AtomicCounter: 70,586&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="265" x="358" y="116" as="geometry" />
        </mxCell>
        <mxCell id="pod_c" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1;align=center;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 11px; color: #0F172A;&quot;&gt;pod-order-c&lt;/b&gt; &amp;nbsp; &lt;span style=&quot;font-size: 10px; color: #92400E;&quot;&gt;AtomicCounter: 3,420&lt;/span&gt;" vertex="1">
