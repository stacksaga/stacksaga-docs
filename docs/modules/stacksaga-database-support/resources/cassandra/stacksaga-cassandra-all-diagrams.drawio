  <diagram id="tryout-colocation" name="Tryout Colocation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="300" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Parent Partition Container -->
        <mxCell id="part_box" value="&lt;b style=&quot;font-size: 12.5px; color: #0F172A;&quot;&gt;Physical Cassandra Node: Single Partition for Entire Transaction Lifecycle&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10.5px; color: #0369A1; font-family: monospace;&quot;&gt;PRIMARY KEY ((region, cluster, service_name, transaction_id), tryout_index ASC)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=1;dashPattern=4 4;verticalAlign=top;align=left;spacingLeft=20;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="860" height="240" as="geometry" />
        </mxCell>

        <!-- Parent Header Row -->
        <mxCell id="parent_row" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;Parent Transaction State (Row 0)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #0369A1; font-family: monospace;&quot;&gt;es_transaction | status = 'IN_FLIGHT' | payload = BLOB&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;spacingLeft=45;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="820" height="45" as="geometry" />
        </mxCell>
        <mxCell id="bp1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="58" y="92" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Colocated Tryout History -->
        <mxCell id="tryout_label" value="&lt;b style=&quot;font-size: 11.5px; color: #475569;&quot;&gt;Colocated Tryout History Rows (Ordered by tryout_index ASC):&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="135" width="500" height="20" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="step1" value="&lt;b&gt;Step 1: Check Inventory&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #16A34A;&quot;&gt;status = 'COMPLETED'&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;tryout_index = 1&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="165" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="step2" value="&lt;b&gt;Step 2: Reserve Balance&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #DC2626;&quot;&gt;status = 'TRANSIENT_FAILED'&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;tryout_index = 2&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="165" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="step3" value="&lt;b&gt;Step 3: Retry Balance&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #D97706;&quot;&gt;status = 'IN_PROGRESS'&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;tryout_index = 3&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="550" y="165" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Guarantee Note -->
        <mxCell id="badge_seek" value="&lt;b style=&quot;font-size: 11px; color: #047857;&quot;&gt;Single Disk Seek Guarantee&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Zero cross-node reads&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="690" y="42" width="180" height="32" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="write-protection-strict" name="STRICT Write Protection">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="320" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Inflow -->
        <mxCell id="wp1" value="&lt;b&gt;Kafka Event Inflow&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10.5px; color: #475569;&quot;&gt;At-least-once message&lt;br/&gt;delivery from broker&lt;br/&gt;&lt;br/&gt;May deliver duplicate&lt;br/&gt;execution events&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="25" y="40" width="165" height="240" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="35" y="50" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Step 1: LWT Lock -->
        <mxCell id="wp2" value="&lt;b&gt;1. Paxos LWT Lease&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #0369A1; font-family: monospace;&quot;&gt;INSERT IF NOT EXISTS&lt;br/&gt;USING TTL 5s&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;• If applied: Acquire lease&lt;br/&gt;• If exists (TTL&gt;0): Back off&lt;br/&gt;• If committed (TTL=0): Skip&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="40" width="195" height="240" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="240" y="50" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Step 2: Execution -->
        <mxCell id="wp3" value="&lt;b&gt;2. Mutual Execution&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10.5px; color: #475569;&quot;&gt;Single pod holding lease&lt;br/&gt;executes business logic&lt;br/&gt;&lt;br/&gt;&lt;b style=&quot;color: #10B981;&quot;&gt;Zero Duplicate Side-Effects&lt;/b&gt;&lt;br/&gt;No double billing&lt;br/&gt;No duplicate inventory&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="465" y="40" width="185" height="240" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#16A34A;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="475" y="50" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Step 3: Commit -->
        <mxCell id="wp4" value="&lt;b&gt;3. Permanent Commit&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #0369A1; font-family: monospace;&quot;&gt;UPDATE markers&lt;br/&gt;SET state='COMMITTED'&lt;br/&gt;TTL = 0&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Converts lease to permanent&lt;br/&gt;marker. Deleted at end of&lt;br/&gt;transaction lifecycle.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="690" y="40" width="200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#7C3AED;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="700" y="50" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="ew1" edge="1" parent="1" source="wp1" target="wp2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.8;endArrow=classic;endFill=1;">
