          <mxGeometry x="281" y="325" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Column 3 Header: Execution -->
        <mxCell id="col3_header" value="3. Execution &amp;amp; Drop" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.2;align=left;spacingLeft=12;fontFamily=Helvetica;fontColor=#065F46;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="210" height="36" as="geometry" />
        </mxCell>

        <!-- Step 7 -->
        <mxCell id="step_7" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Concurrent Re-Invoke&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #64748B;&quot;&gt;Lazy fetch es_transaction&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #059669; font-weight: bold;&quot;&gt;Controlled concurrency&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="130" width="210" height="74" as="geometry" />
