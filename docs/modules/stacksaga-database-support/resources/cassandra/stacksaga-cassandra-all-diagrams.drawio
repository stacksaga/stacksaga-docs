  <diagram id="transaction-throughput" name="Transaction Throughput">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="320" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Left: Inflow Requests -->
        <mxCell id="inflow_box" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;High Inflow Requests&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #475569;&quot;&gt;100,000+ Concurrent&lt;br/&gt;Saga Transactions&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
