        <!-- Middle: Murmur3 Partitioner -->
        <mxCell id="hash_box" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;Murmur3 Partitioner&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 11px; color: #475569;&quot;&gt;64-bit Uniform Hash&lt;br/&gt;&lt;code style=&quot;color: #0369A1;&quot;&gt;token(transaction_id)&lt;/code&gt;&lt;br/&gt;&lt;br/&gt;• Zero coordination&lt;br/&gt;• Uniform scatter&lt;br/&gt;• Eliminates hot spots&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
