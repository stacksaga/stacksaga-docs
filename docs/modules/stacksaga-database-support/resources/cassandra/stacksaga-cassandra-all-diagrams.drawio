        <mxCell id="subtitle" value="Sequential lifecycle from error ingestion and worker discovery to execution and directory compaction" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748B;fontFamily=Helvetica;" vertex="1" parent="1">
