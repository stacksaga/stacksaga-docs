          <mxGeometry x="741" y="141" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Step 11 -->
        <mxCell id="step_11" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Directory Compaction&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #5B21B6; font-weight: bold;&quot;&gt;• Tier 2 Minute Window&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;Deletes window record&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #5B21B6; font-weight: bold;&quot;&gt;• Tier 1 Calendar Date&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;Deletes date when empty&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="730" y="270" width="210" height="118" as="geometry" />
        </mxCell>
        <mxCell id="badge_11" value="11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="741" y="281" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Base Banner -->
        <mxCell id="base_banner" value="&lt;b style=&quot;font-size: 12px; color: #0F172A;&quot;&gt;Complete Lifecycle Invariant: Zero Phantom Reads &amp;amp; Zero Tombstone Leakage&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;Write-ahead to W+1 isolates readers • O(1) partition deletions prevent tombstone accumulation • Node-0 ensures clean tree pruning&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=55;fontFamily=Helvetica;" vertex="1" parent="1">
