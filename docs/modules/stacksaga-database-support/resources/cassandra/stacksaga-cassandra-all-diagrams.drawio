        <mxCell id="token_ring_inner" value="&lt;b style=&quot;font-size: 11px; color: #0F172A;&quot;&gt;Murmur3 Ring&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 8.5px; color: #64748B;&quot;&gt;-2⁶³ to 2⁶³-1&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1.2;align=center;" vertex="1" parent="1">
          <mxGeometry x="428" y="168" width="124" height="124" as="geometry" />
