          <mxGeometry x="40" y="80" width="210" height="36" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="step_1" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Target Window W+1&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #64748B;&quot;&gt;Failure targets next window&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #D97706; font-weight: bold;&quot;&gt;Write-ahead bypass&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
