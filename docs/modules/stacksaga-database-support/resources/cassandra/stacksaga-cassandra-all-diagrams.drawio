          <mxGeometry x="51" y="233" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="step_3" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Path &amp;amp; Metadata Insert&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #64748B;&quot;&gt;Tiers 1-4 directory paths&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #D97706; font-weight: bold;&quot;&gt;Appends pointer to Tier 5&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
