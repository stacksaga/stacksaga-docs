        <!-- Step 5 -->
        <mxCell id="step_5" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Top-Down Discovery&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #64748B;&quot;&gt;Scans Tier 1 → Tier 2&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #2563EB; font-weight: bold;&quot;&gt;Filters Tier 3 token range&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="222" width="210" height="74" as="geometry" />
