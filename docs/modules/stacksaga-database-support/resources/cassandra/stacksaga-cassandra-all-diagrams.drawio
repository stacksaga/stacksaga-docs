        <mxCell id="tx1" value="&lt;span style=&quot;font-family: monospace; font-size: 10px; color: #0369A1;&quot;&gt;Txn-1: 9b1deb4d-3b7d...&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;" vertex="1" parent="1">
