        <mxCell id="ring_badge" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="477" y="180" width="26" height="26" as="geometry" />
        </mxCell>

        <!-- Arrow: Hash to Ring -->
        <mxCell id="edge_hash_ring" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.8;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="hash_box" target="token_ring">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: Coordinator to Ring -->
        <mxCell id="edge_coord_ring" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.8;endArrow=block;endFill=1;endSize=5;" edge="1" parent="1" source="coord_card" target="token_ring">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Worker Node-0 (Blue) -->
        <mxCell id="worker_0" value="&lt;b style=&quot;font-size: 12px; color: #1E40AF;&quot;&gt;Retry Worker Node-0&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #0F172A; font-weight: bold;&quot;&gt;WHERE instance_id_token IN Sector 0&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;Queries only owned token bounds&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="42" y="395" width="270" height="74" as="geometry" />
        </mxCell>
        <mxCell id="worker_0_tag" value="Lease: Sector 0" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;fontColor=#1D4ED8;fontSize=8.5;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="206" y="405" width="92" height="18" as="geometry" />
        </mxCell>

        <!-- Worker Node-1 (Emerald) -->
        <mxCell id="worker_1" value="&lt;b style=&quot;font-size: 12px; color: #065F46;&quot;&gt;Retry Worker Node-1&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #0F172A; font-weight: bold;&quot;&gt;WHERE instance_id_token IN Sector 1&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;Queries only owned token bounds&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.2;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1">
