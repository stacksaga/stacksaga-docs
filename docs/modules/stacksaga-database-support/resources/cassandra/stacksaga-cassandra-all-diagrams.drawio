        <!-- Step 10 -->
        <mxCell id="step_10" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Gate 1 &amp;amp; 2 Verification&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #5B21B6; font-weight: bold;&quot;&gt;• Gate 1: Cluster Scan&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;Zero instances in Tier 3&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #5B21B6; font-weight: bold;&quot;&gt;• Gate 2: Time Elapsed&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;Window passed into history&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
