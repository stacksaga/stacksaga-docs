        <mxCell id="vc2_std_pod1" value="order-service&lt;br/&gt;&lt;b&gt;pod-order-1 (Writer)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D0CEE2;strokeColor=#56517E;strokeWidth=1.2;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="543" y="342" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="vc2_std_podN" value="order-service&lt;br/&gt;&lt;b&gt;pod-order-N (Writer)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D0CEE2;strokeColor=#56517E;strokeWidth=1.2;fontSize=10.5;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="543" y="445" width="160" height="44" as="geometry" />
        </mxCell>
        <!-- VC2: Retry-Nodes Subcontainer -->
        <mxCell id="vc2_retry_box" value="&lt;b style=&quot;font-size: 10.5px; color: #10739E;&quot;&gt;Retry-Nodes (~1k)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 8.5px; color: #666666;&quot;&gt;Readers (≤ W) &amp;amp; Forward Writers&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#10739E;strokeWidth=1.2;dashed=1;dashPattern=3 3;verticalAlign=top;align=center;spacingTop=6;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="723" y="298" width="200" height="218" as="geometry" />
        </mxCell>
        <mxCell id="vc2_retry_node1" value="order-service&lt;br/&gt;&lt;b&gt;retry-node-1&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1.2;fontSize=10.5;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="733" y="342" width="180" height="46" as="geometry" />
        </mxCell>
        <mxCell id="vc2_badge_rn1" value="Retry-Support" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFF88;strokeColor=#36393D;strokeWidth=1;fontSize=8;fontStyle=1;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="841" y="354" width="64" height="20" as="geometry" />
        </mxCell>
        <mxCell id="vc2_retry_nodeN" value="order-service&lt;br/&gt;&lt;b&gt;retry-node-N&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;strokeWidth=1.2;fontSize=10.5;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="733" y="445" width="180" height="46" as="geometry" />
        </mxCell>
        <mxCell id="vc2_badge_rnN" value="Retry-Support" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFF88;strokeColor=#36393D;strokeWidth=1;fontSize=8;fontStyle=1;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="841" y="457" width="64" height="20" as="geometry" />
        </mxCell>
        <!-- RSocket connection arrows between Slave and Retry-Nodes -->
        <mxCell id="edge_vc2_rsocket1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#36393D;strokeWidth=1.4;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="vc2_slave1" target="vc2_retry_node1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_vc2_rsocketN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#36393D;strokeWidth=1.4;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="vc2_slaveN" target="vc2_retry_nodeN">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== APACHE CASSANDRA (SHARED) ==================== -->
        <mxCell id="cass_box" value="&lt;b style=&quot;font-size: 13.5px; color: #0F172A;&quot;&gt;Apache Cassandra (Shared Database Cluster &amp;amp; Keyspace)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10.5px; color: #555555;&quot;&gt;Both virtual clusters connect to the same keyspace; Cassandra physically separates partitions via composite keys&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=1.8;verticalAlign=top;align=center;spacingTop=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="20" y="580" width="940" height="175" as="geometry" />
        </mxCell>

        <!-- Cluster 1 Partition Card -->
        <mxCell id="c1_part_card" value="&lt;b style=&quot;font-size: 10px; color: #1D4ED8;&quot;&gt;Cluster 1 Partition Space&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 9.5px; color: #0F172A;&quot;&gt;Tier 3 PK: ((us-central, us-central-cluster-1, order-service, date, win))&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #0E8088;&quot;&gt;✓ Max 10,000 instance rows (&amp;lt; 50,000 partition threshold)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;• Standard-Nodes write ahead (W+1) via AtomicLong&lt;br/&gt;• Cluster-1 Retry-Nodes read (≤ W) &amp;amp; drop buckets via O(1) tombstones&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10739E;strokeWidth=1.3;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="35" y="632" width="435" height="110" as="geometry" />
        </mxCell>

        <!-- Cluster 2 Partition Card -->
        <mxCell id="c2_part_card" value="&lt;b style=&quot;font-size: 10px; color: #6D28D9;&quot;&gt;Cluster 2 Partition Space&lt;/b&gt;&lt;br/&gt;&lt;b style=&quot;font-size: 9.5px; color: #0F172A;&quot;&gt;Tier 3 PK: ((us-central, us-central-cluster-2, order-service, date, win))&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #6D28D9;&quot;&gt;✓ Max 10,000 instance rows (&amp;lt; 50,000 partition threshold)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;• Standard-Nodes write ahead (W+1) via AtomicLong&lt;br/&gt;• Cluster-2 Retry-Nodes read (≤ W) &amp;amp; drop buckets via O(1) tombstones&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=1.3;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="510" y="632" width="435" height="110" as="geometry" />
        </mxCell>

        <!-- Downward Arrows from Clusters to Cassandra -->
        <mxCell id="edge_c1_to_cass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10739E;strokeWidth=1.8;dashed=1;dashPattern=4 4;endArrow=classic;endFill=1;" edge="1" parent="1" source="vc1_nodes_box" target="c1_part_card">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_c2_to_cass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B1FA2;strokeWidth=1.8;dashed=1;dashPattern=4 4;endArrow=classic;endFill=1;" edge="1" parent="1" source="vc2_nodes_box" target="c2_part_card">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="node0-compaction-gates" name="Node-0 Compaction Gates">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="340" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Node-0 Compactor Overseer: Two-Gate Verification Protocol" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="600" height="24" as="geometry" />
        </mxCell>

        <!-- Gate 1 -->
        <mxCell id="g1_box" value="&lt;b style=&quot;font-size: 13px; color: #1E40AF;&quot;&gt;GATE 1: Tier 3 Instance Partition Scan&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #0369A1; font-family: monospace;&quot;&gt;SELECT instance_id FROM es_instances_by_recovery_window&lt;br/&gt;WHERE date_of_year = :date AND minute_of_day = :window&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10.5px; color: #475569;&quot;&gt;• Single-partition, exact-key in-memory scan&lt;br/&gt;• Verifies 0 rows remaining across all instances&lt;br/&gt;• If rows exist: Window still active, compaction aborts&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="bg1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="52" y="72" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Gate 2 -->
        <mxCell id="g2_box" value="&lt;b style=&quot;font-size: 13px; color: #7C3AED;&quot;&gt;GATE 2: Ring Coordinator Lease Verification&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #0369A1; font-family: monospace;&quot;&gt;ringCoordinator.getActiveLeases(window)&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10.5px; color: #475569;&quot;&gt;• Confirms all worker sector leases have expired or drained&lt;br/&gt;• Guarantees zero workers are in-flight mid-transaction&lt;br/&gt;• Prevents race condition during slow network re-invocations&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="60" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="bg2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#7C3AED;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="512" y="72" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Action Box -->
        <mxCell id="act_box" value="&lt;b style=&quot;font-size: 12px; color: #166534;&quot;&gt;Compaction Execution: Delete Window &amp;amp; Day Directory Markers&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #0369A1; font-family: monospace;&quot;&gt;DELETE FROM es_recovery_windows_by_day WHERE minute_of_day = :window&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;When minute 1439 is deleted, Day T is cleanly removed from Tier 1 (es_days_by_year)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1.2;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="500" y="215" width="380" height="75" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="eg1" edge="1" parent="1" source="g1_box" target="g2_box" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eg2" edge="1" parent="1" source="g2_box" target="act_box" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=2;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>