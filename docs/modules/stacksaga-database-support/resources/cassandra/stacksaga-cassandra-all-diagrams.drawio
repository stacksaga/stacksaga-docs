          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="restore-dead-mans-switch" name="Restore Dead-Mans Switch">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="340" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="The Restore Dead-Man's Switch Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="600" height="24" as="geometry" />
        </mxCell>

        <!-- Path A: Normal Completion -->
        <mxCell id="box_a" value="&lt;b style=&quot;font-size: 12px; color: #166534;&quot;&gt;PATH A: Normal Completion (99.9% of transactions)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="45" width="860" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ba1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#16A34A;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="42" y="55" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="a_step1" value="&lt;b&gt;Standard-Node Starts Txn&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Writes watchdog row into&lt;br/&gt;Odd bucket (W+K, e.g. +10h)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="85" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_step2" value="&lt;b&gt;Saga Executes Cleanly&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;All steps finish in 200ms&lt;br/&gt;Order confirmed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="345" y="85" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a_step3" value="&lt;b&gt;Watchdog Row Disarmed&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #166534;&quot;&gt;Direct partition delete using&lt;br/&gt;stored restore path (Zero trace)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="85" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ea1" edge="1" parent="1" source="a_step1" target="a_step2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ea2" edge="1" parent="1" source="a_step2" target="a_step3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Path B: Silent Pod Crash -->
        <mxCell id="box_b" value="&lt;b style=&quot;font-size: 12px; color: #991B1B;&quot;&gt;PATH B: Silent Pod Crash (Power outage, OOM kill, ungraceful termination)&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="185" width="860" height="135" as="geometry" />
        </mxCell>
        <mxCell id="bb1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DC2626;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="42" y="195" width="20" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b_step1" value="&lt;b&gt;Pod Crashes Silently&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #991B1B;&quot;&gt;No error written to database&lt;br/&gt;Watchdog row remains intact&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCA5A5;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="235" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b_step2" value="&lt;b&gt;Time Elapsed: +10 Hours&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Wall clock reaches window W+K&lt;br/&gt;Retry-Node sweeps Odd bucket&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="345" y="235" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="b_step3" value="&lt;b&gt;Orphan Rescued&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #1E40AF;&quot;&gt;Query es_transaction status&lt;br/&gt;Transaction re-invoked cleanly&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="640" y="235" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="eb1" edge="1" parent="1" source="b_step1" target="b_step2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=1.5;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eb2" edge="1" parent="1" source="b_step2" target="b_step3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=1.5;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="odd-even-bucket-segregation" name="Odd-Even Bucket Segregation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="430" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Odd vs. Even Bucket Segregation (Tombstone Isolation)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="600" height="24" as="geometry" />
        </mxCell>

        <!-- Even Buckets Container -->
        <mxCell id="even_box" value="&lt;b style=&quot;font-size: 13px; color: #1E3A8A;&quot;&gt;EVEN BUCKETS (0, 2, 4...) • RETRY TRANSACTIONS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="900" height="155" as="geometry" />
        </mxCell>
        <mxCell id="be1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="42" y="68" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="even_card1" value="&lt;b&gt;Failure-Only Writes&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Rows inserted ONLY when a step fails&lt;br/&gt;0.01% - 1% of total transaction traffic&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="even_card2" value="&lt;b&gt;Sparse Partitions&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Few rows per partition&lt;br/&gt;Negligible tombstone risk on scan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="105" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="even_card3" value="&lt;b&gt;Fast Compaction&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Partition tombstone drop when complete&lt;br/&gt;Clean sequential bucket release&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="105" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Odd Buckets Container -->
        <mxCell id="odd_box" value="&lt;b style=&quot;font-size: 13px; color: #5B21B6;&quot;&gt;ODD BUCKETS (1, 3, 5...) • RESTORE WATCHDOGS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="235" width="900" height="155" as="geometry" />
        </mxCell>
        <mxCell id="bo1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#7C3AED;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="42" y="248" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="odd_card1" value="&lt;b&gt;High-Volume Watchdogs&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Watchdog row written for EVERY transaction start&lt;br/&gt;Produces cell deletes upon normal completion&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="285" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="odd_card2" value="&lt;b&gt;Tombstone Isolation&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Segregated from Retry reading path&lt;br/&gt;Retry queries never cross watchdog tombstones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="285" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="odd_card3" value="&lt;b&gt;O(1) Compaction Drop&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;When window passes, entire bucket dropped&lt;br/&gt;Single partition tombstone clears all cells&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="285" width="260" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="virtual-clusters" name="Virtual Clusters &amp; Cell Isolation">
