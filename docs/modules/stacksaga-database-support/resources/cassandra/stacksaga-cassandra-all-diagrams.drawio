  <diagram id="deep-historical-recovery" name="Deep Historical Recovery">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="280" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Deep Historical Lookback Across Calendar Days" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="600" height="24" as="geometry" />
        </mxCell>

        <!-- Day T-2 -->
        <mxCell id="day_t2" value="&lt;b style=&quot;font-size: 13px; color: #0F172A;&quot;&gt;Day T-2 (2 Days Ago)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #0369A1; font-family: monospace;&quot;&gt;date_of_year = 2026-09-20&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;• Extended outage backlog&lt;br/&gt;• Swept first on startup&lt;br/&gt;• Once done, day deleted from Tier 1&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b11_1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#D97706;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Day T-1 -->
        <mxCell id="day_t1" value="&lt;b style=&quot;font-size: 13px; color: #0F172A;&quot;&gt;Day T-1 (Yesterday)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #0369A1; font-family: monospace;&quot;&gt;date_of_year = 2026-09-21&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;• Prior day residual failures&lt;br/&gt;• Swept sequentially next&lt;br/&gt;• Compaction gates verified&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="60" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b11_2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Day T -->
        <mxCell id="day_t0" value="&lt;b style=&quot;font-size: 13px; color: #0F172A;&quot;&gt;Day T (Today - Live)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #0369A1; font-family: monospace;&quot;&gt;date_of_year = 2026-09-22&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;• Real-time retry/restore windows&lt;br/&gt;• Pipeline catches up to live minute&lt;br/&gt;• Continuous per-minute recovery&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="60" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="b11_3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#16A34A;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="70" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="ed1" edge="1" parent="1" source="day_t2" target="day_t1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=classic;endFill=1;">
