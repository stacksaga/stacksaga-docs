          <mxGeometry x="51" y="141" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="step_2" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Atomic Counter Check&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #64748B;&quot;&gt;Local JVM rollover (&amp;lt; 50k)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #D97706; font-weight: bold;&quot;&gt;Selects bucket_index&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
