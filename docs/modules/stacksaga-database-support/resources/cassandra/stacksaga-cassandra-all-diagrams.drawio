        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="6WFRymQv1p90ZBV-yjgb-1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#BFDBFE;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=55;spacingTop=10;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="230" width="900" x="40" y="490" as="geometry" />
