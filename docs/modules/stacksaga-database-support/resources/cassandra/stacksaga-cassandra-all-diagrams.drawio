  <diagram id="instance-bucket-distribution" name="Instance Bucketing &amp; Worker Re-Distribution">
    <mxGraphModel dx="719" dy="432" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" background="#FAFBFD" math="0" shadow="0">
