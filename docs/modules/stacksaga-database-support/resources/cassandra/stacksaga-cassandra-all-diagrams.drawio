        <!-- Step 9 -->
        <mxCell id="step_9" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Instance Marker Delete&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #64748B;&quot;&gt;All buckets completed&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #059669; font-weight: bold;&quot;&gt;Removes Tier 3 marker&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
