<mxfile host="app.diagrams.net" modified="2026-09-23T18:35:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="odd-even-bucket-segregation" name="Odd-Even Bucket Segregation">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="430" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Odd vs. Even Bucket Segregation (Tombstone Isolation)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="600" height="24" as="geometry" />
        </mxCell>

        <!-- Even Buckets Container -->
        <mxCell id="even_box" value="&lt;b style=&quot;font-size: 13px; color: #1E3A8A;&quot;&gt;EVEN BUCKETS (0, 2, 4...) • RETRY TRANSACTIONS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="900" height="155" as="geometry" />
        </mxCell>
        <mxCell id="be1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="42" y="68" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="even_card1" value="&lt;b&gt;Failure-Only Writes&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Rows inserted ONLY when a step fails&lt;br/&gt;0.01% - 1% of total transaction traffic&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="even_card2" value="&lt;b&gt;Sparse Partitions&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Few rows per partition&lt;br/&gt;Negligible tombstone risk on scan&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="105" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="even_card3" value="&lt;b&gt;Fast Compaction&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Partition tombstone drop when complete&lt;br/&gt;Clean sequential bucket release&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="105" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- Odd Buckets Container -->
        <mxCell id="odd_box" value="&lt;b style=&quot;font-size: 13px; color: #5B21B6;&quot;&gt;ODD BUCKETS (1, 3, 5...) • RESTORE WATCHDOGS&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=45;spacingTop=15;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="235" width="900" height="155" as="geometry" />
        </mxCell>
        <mxCell id="bo1" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#7C3AED;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="42" y="248" width="22" height="22" as="geometry" />
        </mxCell>
        <mxCell id="odd_card1" value="&lt;b&gt;High-Volume Watchdogs&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Watchdog row written for EVERY transaction start&lt;br/&gt;Produces cell deletes upon normal completion&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="285" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="odd_card2" value="&lt;b&gt;Tombstone Isolation&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Segregated from Retry reading path&lt;br/&gt;Retry queries never cross watchdog tombstones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="285" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="odd_card3" value="&lt;b&gt;O(1) Compaction Drop&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;When window passes, entire bucket dropped&lt;br/&gt;Single partition tombstone clears all cells&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontFamily=Helvetica;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="285" width="260" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>