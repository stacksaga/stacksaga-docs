          <mxGeometry x="281" y="233" width="22" height="22" as="geometry" />
        </mxCell>

        <!-- Step 6 -->
        <mxCell id="step_6" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Metadata Streaming&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #64748B;&quot;&gt;Discovers Tier 4 buckets&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #2563EB; font-weight: bold;&quot;&gt;Streams Tier 5 records&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
