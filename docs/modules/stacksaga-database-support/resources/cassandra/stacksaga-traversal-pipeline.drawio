        <!-- Base Banner -->
        <mxCell id="base_banner" value="&lt;b style=&quot;font-size: 12px; color: #0F172A;&quot;&gt;Complete Lifecycle Invariant: Zero Phantom Reads &amp;amp; Zero Tombstone Leakage&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #64748B;&quot;&gt;Write-ahead to W+1 isolates readers • O(1) partition deletions prevent tombstone accumulation • Node-0 ensures clean tree pruning&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=55;fontFamily=Helvetica;" vertex="1" parent="1">
