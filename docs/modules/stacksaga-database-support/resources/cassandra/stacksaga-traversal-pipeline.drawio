        <!-- Step 11 -->
        <mxCell id="step_11" value="&lt;b style=&quot;font-size: 11.5px; color: #0F172A;&quot;&gt;Directory Compaction&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #5B21B6; font-weight: bold;&quot;&gt;• Tier 2 Minute Window&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;Deletes window record&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #5B21B6; font-weight: bold;&quot;&gt;• Tier 1 Calendar Date&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9px; color: #64748B;&quot;&gt;Deletes date when empty&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;spacingLeft=40;fontFamily=Helvetica;" vertex="1" parent="1">
