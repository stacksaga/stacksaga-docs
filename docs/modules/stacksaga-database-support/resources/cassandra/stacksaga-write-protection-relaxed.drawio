<mxfile host="app.diagrams.net" modified="2026-09-23T18:35:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="write-protection-relaxed" name="RELAXED Write Protection">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="280" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Stream Inflow -->
        <mxCell id="rp1" value="&lt;b&gt;Streaming Event Inflow&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10.5px; color: #475569;&quot;&gt;High-throughput pipeline&lt;br/&gt;Operations are inherently&lt;br/&gt;idempotent&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="190" height="200" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Read Check -->
        <mxCell id="rp2" value="&lt;b&gt;1. Non-Blocking Read Check&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #0369A1; font-family: monospace;&quot;&gt;SELECT execution_state&lt;br/&gt;FROM es_execution_markers&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;• Fast single-partition read&lt;br/&gt;• Skips Paxos consensus roundtrip&lt;br/&gt;• If marker present: Terminate immediately&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="40" width="270" height="200" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#2563EB;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Atomic Batch Write -->
        <mxCell id="rp3" value="&lt;b&gt;2. Atomic Batch Write&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 9.5px; color: #0369A1; font-family: monospace;&quot;&gt;BEGIN BATCH&lt;br/&gt;  INSERT INTO es_transaction_tryout...&lt;br/&gt;  INSERT INTO es_execution_markers...&lt;br/&gt;APPLY BATCH;&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 10px; color: #475569;&quot;&gt;Step results &amp;amp; markers committed in a single atomic logged batch.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=45;spacingTop=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="310" height="200" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#16A34A;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="590" y="50" width="20" height="20" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="er1" edge="1" parent="1" source="rp1" target="rp2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.8;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er2" edge="1" parent="1" source="rp2" target="rp3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.8;endArrow=classic;endFill=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
