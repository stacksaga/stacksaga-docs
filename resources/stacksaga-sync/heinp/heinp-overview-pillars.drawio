<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="heinp-pillars" name="HEINP Three Pillars">
    <mxGraphModel dx="800" dy="300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pillar 1 -->
        <mxCell id="p1" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Synchronous In-Thread&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369a1&quot; style=&quot;font-size: 11px;&quot;&gt;.asSync().noPause()&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;REST • gRPC • Local DB&lt;br/&gt;Immediate in-thread handoff&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Pillar 2 -->
        <mxCell id="p2" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Broker Outbox Dispatch&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 11px;&quot;&gt;.asAsync().invoker(...)&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Apache Kafka • RabbitMQ • SQS&lt;br/&gt;DB commit FIRST ➔ Lazy emit&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="30" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Pillar 3 -->
        <mxCell id="p3" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Suspended Wait-State&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 11px;&quot;&gt;.pauseUntilResume(duration)&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;External Webhooks • Approvals&lt;br/&gt;Zero thread starvation&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="30" width="220" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
