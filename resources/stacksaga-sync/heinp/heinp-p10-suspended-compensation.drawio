<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p10-suspended-revert" name="Suspended Compensation Gateway">
    <mxGraphModel dx="800" dy="250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Command doRevert() -->
        <mxCell id="rev_cmd" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Command.doRevert()&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#e11d48&quot; style=&quot;font-size: 9px;&quot;&gt;Submits bank refund request&lt;br/&gt;Calls .pauseUntilResume(...)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="35" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- SEC Pause State -->
        <mxCell id="sec_revert_pause" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;SEC Revert Pause&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 9px;&quot;&gt;Rollback pipeline paused&lt;br/&gt;Worker thread released&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="280" y="25" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- Resumed Revert Flow -->
        <mxCell id="rev_resumed" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Resume &amp;amp; Unwind&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 9px;&quot;&gt;Bank confirms settlement&lt;br/&gt;SEC continues to prior command&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="520" y="35" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value=".pauseUntilResume(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;fontSize=9;fontColor=#b45309;" edge="1" parent="1" source="rev_cmd" target="sec_revert_pause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="Webhook Callback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=9;fontColor=#047857;" edge="1" parent="1" source="sec_revert_pause" target="rev_resumed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
