<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p10b-async-revert" name="Asynchronous Broker Compensation Dispatcher">
    <mxGraphModel dx="800" dy="300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Step 1: doRevert Stage -->
        <mxCell id="rev_cmd" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;1. Command.doRevert()&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#e11d48&quot; style=&quot;font-size: 9px;&quot;&gt;Configures AsyncInvoker&lt;br/&gt;Calls: .asAsync().invoker(...)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="25" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Step 2: SEC DB Commit FIRST -->
        <mxCell id="sec_revert_db" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;2. DB Commit &amp;amp; Pause FIRST&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 9px;&quot;&gt;Logs event &amp;amp; sets is_paused = 1&lt;br/&gt;&lt;b color=&quot;#047857&quot;&gt;Zero Race Condition!&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="285" y="15" width="195" height="75" as="geometry" />
        </mxCell>

        <!-- Step 3: Lazy Broker Dispatch -->
        <mxCell id="step_lazy_broker" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;3. Lazy Broker Dispatch&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 9px;&quot;&gt;Publishes refund event to Kafka&lt;br/&gt;Runs ONLY after DB commit&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="540" y="25" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Step 4: Callback & Reverse Unwind -->
        <mxCell id="step_revert_unwind" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;4. External Callback &amp;amp; Reverse Routing&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size: 9px;&quot;&gt;SagaTemplate.resume(resumeKey) arrives&lt;br/&gt;&lt;b color=&quot;#0f172a&quot;&gt;SEC automatically compensates preceding command in history&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="140" y="115" width="480" height="48" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value=".asAsync().invoker(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.5;fontSize=9;fontColor=#e11d48;" edge="1" parent="1" source="rev_cmd" target="sec_revert_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="Lazy Execution" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=9;fontColor=#047857;" edge="1" parent="1" source="sec_revert_db" target="step_lazy_broker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Kafka Consumer triggers resume(key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;" edge="1" parent="1" source="step_lazy_broker" target="step_revert_unwind">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
