<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p11-pre-revert-guard" name="Pre-Revert Guard Handover">
    <mxGraphModel dx="800" dy="250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- RevertBeforeExecutor -->
        <mxCell id="hook_before" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;RevertBeforeExecutor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#7e22ce&quot; style=&quot;font-size: 9px;&quot;&gt;Acquires Refund Token / Lock&lt;br/&gt;Calls: .toNextDefaultExecutor()&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="35" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- RevertHintStore Badge -->
        <mxCell id="hint_store" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;RevertHintStore&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#7e22ce&quot; style=&quot;font-size: 9px;&quot;&gt;hintStore.put(&quot;TOKEN&quot;, token)&lt;br/&gt;Scoped Claim-Check Handoff&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;strokeWidth=1;fontColor=#7e22ce;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- Target Command doRevert() -->
        <mxCell id="target_revert" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Target Command.doRevert()&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#e11d48&quot; style=&quot;font-size: 9px;&quot;&gt;Consumes hintStore.get(&quot;TOKEN&quot;)&lt;br/&gt;Executes core compensation logic&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="520" y="35" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="Writes Hint" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#a855f7;strokeWidth=1.5;fontSize=9;fontColor=#7e22ce;" edge="1" parent="1" source="hook_before" target="hint_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="toNextDefaultExecutor()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.5;fontSize=9;fontColor=#9f1239;" edge="1" parent="1" source="hint_store" target="target_revert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
