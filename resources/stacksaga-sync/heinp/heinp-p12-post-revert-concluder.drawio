<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p12-post-revert-concluder" name="Post-Revert Concluder Handover">
    <mxGraphModel dx="800" dy="250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Target Command Revert -->
        <mxCell id="cmd_revert" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;1. Command E.doRevert()&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#e11d48&quot; style=&quot;font-size: 9px;&quot;&gt;Core rollback completed&lt;br/&gt;Calls resumeToNextDefaultExecutor()&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="35" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- RevertAfterExecutor -->
        <mxCell id="hook_after" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;2. RevertAfterExecutor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#15803d&quot; style=&quot;font-size: 9px;&quot;&gt;Customer Email / Audit Telemetry&lt;br/&gt;Calls: .toNextDefaultExecutor()&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="270" y="35" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- SEC Next Revert -->
        <mxCell id="sec_prior" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;3. SEC Unwinds Backward&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 9px;&quot;&gt;Command E is 100% finished!&lt;br/&gt;Advances to preceding command&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#f8fafc;strokeColor=#047857;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="520" y="25" width="210" height="85" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="resumeToNextDefaultExecutor()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=1.5;fontSize=8;fontColor=#9f1239;" edge="1" parent="1" source="cmd_revert" target="hook_after">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="toNextDefaultExecutor()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=1.5;fontSize=8;fontColor=#15803d;" edge="1" parent="1" source="hook_after" target="sec_prior">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>