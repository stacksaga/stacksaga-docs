<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p2-pipeline-relay" name="Direct Pipeline Relay">
    <mxGraphModel dx="800" dy="250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- CommandExecutor A -->
        <mxCell id="cmd_a" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;CommandExecutor A&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369a1&quot; style=&quot;font-size: 10px;&quot;&gt;Mutates Step 1 State&lt;br/&gt;Rollback candidate: Step A&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="35" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- SEC Event Store -->
        <mxCell id="sec_store" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;SEC Journal&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#059669&quot; style=&quot;font-size: 10px;&quot;&gt;Appends Step A Record&lt;br/&gt;Snapshot Saved&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#f0fdf4;strokeColor=#059669;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="275" y="25" width="170" height="85" as="geometry" />
        </mxCell>

        <!-- CommandExecutor B -->
        <mxCell id="cmd_b" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;CommandExecutor B&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369a1&quot; style=&quot;font-size: 10px;&quot;&gt;Mutates Step 2 State&lt;br/&gt;Rollback candidate: Step B&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="510" y="35" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="edge1" value=".toNextExecutor(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=10;fontColor=#0369a1;" edge="1" parent="1" source="cmd_a" target="sec_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="edge2" value="Immediate Handover" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=10;fontColor=#0369a1;" edge="1" parent="1" source="sec_store" target="cmd_b">
          <mxGeometry relative="1" as="geometry" />
