<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p3-mutate-probe" name="Mutate-and-Probe">
    <mxGraphModel dx="800" dy="300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="170" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- CommandExecutor -->
        <mxCell id="node_cmd" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;CommandExecutor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369a1&quot; style=&quot;font-size: 10px;&quot;&gt;Alters State (e.g. Voucher Claimed)&lt;br/&gt;Rollback method: doRevert()&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- QueryExecutor (Probe) -->
        <mxCell id="node_query" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;QueryExecutor (Probe)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 10px;&quot;&gt;Inspects Downstream Invariant&lt;br/&gt;(e.g. Fraud Score / Replica Sync)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="470" y="30" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Forward Arrow -->
        <mxCell id="edge_fwd" value=".toNextExecutor(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=10;fontColor=#0369a1;" edge="1" parent="1" source="node_cmd" target="node_query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reverse Counter-Flow on Probe Failure -->
        <mxCell id="edge_revert" value="On Probe Failure: Triggers Command.doRevert() !" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#e11d48;strokeWidth=2;strokeFactor=2;dashed=1;fontSize=10;fontColor=#e11d48;" edge="1" parent="1" source="node_query" target="node_cmd">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="130" />
              <mxPoint x="140" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>