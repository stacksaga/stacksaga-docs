<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p4-filter-chain" name="Multi-Stage Filter Chain">
    <mxGraphModel dx="800" dy="250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Query A -->
        <mxCell id="query_a" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;QueryExecutor A&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 10px;&quot;&gt;Precondition 1 (e.g. Store Open)&lt;br/&gt;[Read-Only Validation]&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="30" y="35" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- SEC Badge -->
        <mxCell id="sec_badge" value="&lt;font color=&quot;#059669&quot; style=&quot;font-size: 10px;&quot;&gt;&lt;b&gt;Zero Compensation Overhead&lt;/b&gt;&lt;br/&gt;Failure aborts with NO rollback debt&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#059669;strokeWidth=1;fontColor=#059669;" vertex="1" parent="1">
          <mxGeometry x="270" y="47" width="180" height="45" as="geometry" />
        </mxCell>

        <!-- Query B -->
        <mxCell id="query_b" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;QueryExecutor B&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 10px;&quot;&gt;Precondition 2 (e.g. Delivery Zone)&lt;br/&gt;[Read-Only Validation]&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="470" y="35" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <mxCell id="edge1" value=".toNextExecutor(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;fontSize=10;fontColor=#b45309;" edge="1" parent="1" source="query_a" target="sec_badge">
          <mxGeometry relative="1" as="geometry" />
