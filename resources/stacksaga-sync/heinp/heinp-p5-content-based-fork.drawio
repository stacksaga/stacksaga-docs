<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p5-content-fork" name="Content-Based Dynamic Fork">
    <mxGraphModel dx="800" dy="350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Current Executor -->
        <mxCell id="curr_exec" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;Current Executor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;Evaluates Aggregate&lt;br/&gt;(DomainEntity)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="65" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- EIP Diamond: Content-Based Router -->
        <mxCell id="router_diamond" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Content-Based&lt;br/&gt;Decision&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=1.5;fontColor=#581c87;" vertex="1" parent="1">
          <mxGeometry x="250" y="55" width="130" height="90" as="geometry" />
        </mxCell>

        <!-- Branch A (Top): VIP Route -->
        <mxCell id="branch_vip" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;VIPPaymentExecutor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#7e22ce&quot; style=&quot;font-size: 9px;&quot;&gt;.toNextExecutor(VIP.class)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9333ea;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="490" y="20" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Branch B (Middle): Standard Route -->
        <mxCell id="branch_std" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;StandardPaymentExecutor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369a1&quot; style=&quot;font-size: 9px;&quot;&gt;.toNextExecutor(Standard.class)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="490" y="80" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Branch C (Bottom): Zero Dollar complete() -->
        <mxCell id="branch_zero" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;Terminal Seal: complete()&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 9px;&quot;&gt;Amount == $0 (No Payment Needed)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#059669;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="490" y="140" width="200" height="45" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="edge_in" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=1.5;" edge="1" parent="1" source="curr_exec" target="router_diamond">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_vip" value="if isVip()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9333ea;strokeWidth=1.5;fontSize=9;fontColor=#9333ea;" edge="1" parent="1" source="router_diamond" target="branch_vip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_std" value="default" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=9;fontColor=#0284c7;" edge="1" parent="1" source="router_diamond" target="branch_std">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_zero" value="amount == 0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=9;fontColor=#059669;" edge="1" parent="1" source="router_diamond" target="branch_zero">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>