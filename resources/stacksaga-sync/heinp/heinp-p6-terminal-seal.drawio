<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p6-terminal-seal" name="Terminal Workflow Seal">
    <mxGraphModel dx="800" dy="250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Final Executor -->
        <mxCell id="node_final" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;Final Step Executor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 10px;&quot;&gt;No more forward spans ahead&lt;br/&gt;Order confirmed / finalized&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="30" y="35" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- SEC Terminal Sink -->
        <mxCell id="node_sink" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Terminal Workflow Seal&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 10px;&quot;&gt;• Status: PROCESS_COMPLETED (SUCCESS)&lt;br/&gt;• Release aggregate locks • Return entity&lt;/font&gt;" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="290" height="80" as="geometry" />
        </mxCell>

        <!-- Arrow -->
        <mxCell id="edge_complete" value=".asSync().noPause().complete()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=10;fontColor=#047857;" edge="1" parent="1" source="node_final" target="node_sink">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>