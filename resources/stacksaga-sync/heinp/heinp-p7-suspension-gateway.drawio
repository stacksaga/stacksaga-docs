<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p7-suspension-gateway" name="Suspension Gateway">
    <mxGraphModel dx="800" dy="350" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Track: Pause Phase -->
        <mxCell id="pausing_exec" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;1. Pausing Executor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 9px;&quot;&gt;Submits async request&lt;br/&gt;Supplies resumeKey&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="25" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sec_pause" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;2. SEC Event Store&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 9px;&quot;&gt;Sets is_paused = 1 in DB&lt;br/&gt;Registers resumeKey&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="270" y="15" width="170" height="75" as="geometry" />
        </mxCell>

        <mxCell id="thread_free" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;3. Thread Liberated!&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 9px;&quot;&gt;Zero CPU/thread starvation&lt;br/&gt;LRT sleeps safely&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="530" y="25" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Bottom Track: Resume Phase -->
        <mxCell id="ext_callback" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;4. External Webhook&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 9px;&quot;&gt;Calls: SagaTemplate.resume(&lt;br/&gt;resumeKey, payload)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="140" y="125" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="resumed_exec" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;5. Resumed Executor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0369a1&quot; style=&quot;font-size: 9px;&quot;&gt;Wakes up with ResumeContext&lt;br/&gt;Advances forward pipeline&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="460" y="125" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value=".pauseUntilResume(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;fontSize=9;fontColor=#b45309;" edge="1" parent="1" source="pausing_exec" target="sec_pause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="Release Thread" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=9;fontColor=#047857;" edge="1" parent="1" source="sec_pause" target="thread_free">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="Injects Context &amp;amp; Resumes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284c7;strokeWidth=1.5;fontSize=9;fontColor=#0369a1;" edge="1" parent="1" source="ext_callback" target="resumed_exec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>