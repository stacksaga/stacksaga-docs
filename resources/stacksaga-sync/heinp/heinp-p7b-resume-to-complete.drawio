<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p7b-resume-complete" name="Suspension Finalizer: resumeToComplete">
    <mxGraphModel dx="800" dy="300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Step 1: Pausing Final Action -->
        <mxCell id="step_pausing" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;1. Final Forward Step&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 9px;&quot;&gt;Initiates Async Delivery / Settlement&lt;br/&gt;Calls: .resumeToComplete()&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="25" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Step 2: SEC Paused State -->
        <mxCell id="step_sec_pause" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;2. SEC Paused State&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size: 9px;&quot;&gt;Sets is_paused = 1 in DB&lt;br/&gt;Thread released (Sleep)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="290" y="15" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- Step 3: Callback Arrival -->
        <mxCell id="step_callback" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;3. External Callback&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 9px;&quot;&gt;SagaTemplate.resume(resumeKey)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="100" y="115" width="210" height="45" as="geometry" />
        </mxCell>

        <!-- Step 4: Direct Terminal Seal -->
        <mxCell id="step_terminal" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;4. Direct Terminal Seal&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 9px;&quot;&gt;Status: PROCESS_COMPLETED (SUCCESS)&lt;br/&gt;&lt;b&gt;No intermediate dummy executor needed!&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=2;fontColor=#065f46;" vertex="1" parent="1">
          <mxGeometry x="400" y="105" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value=".pauseUntilResume(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;fontSize=9;fontColor=#b45309;" edge="1" parent="1" source="step_pausing" target="step_sec_pause">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="Resumes Directly to Completion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontSize=9;fontColor=#047857;" edge="1" parent="1" source="step_callback" target="step_terminal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
