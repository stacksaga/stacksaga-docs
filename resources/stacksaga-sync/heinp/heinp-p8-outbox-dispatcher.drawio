<mxfile host="app.diagrams.net" version="21.0.0" type="device">
  <diagram id="p8-outbox-dispatcher" name="Transactional Outbox Dispatcher">
    <mxGraphModel dx="800" dy="250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="750" pageHeight="140" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Stage 1 -->
        <mxCell id="stage1" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;1. Preparation Stage&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 9px;&quot;&gt;Inside doProcess()&lt;br/&gt;Updates DomainEntity state&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="20" y="35" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Database Commit FIRST -->
        <mxCell id="stage_db" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;2. Database Commit FIRST&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0f172a&quot; style=&quot;font-size: 9px;&quot;&gt;Event Store persists record&lt;br/&gt;&lt;b color=&quot;#059669&quot;&gt;Zero Race Conditions!&lt;/b&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=2;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="275" y="25" width="200" height="85" as="geometry" />
        </mxCell>

        <!-- Stage 2: Lazy Invocation -->
        <mxCell id="stage2" value="&lt;b style=&quot;font-size: 11px;&quot;&gt;3. Lazy AsyncInvoker&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size: 9px;&quot;&gt;Dispatches to Apache Kafka / SQS&lt;br/&gt;Runs ONLY after DB confirmed&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="540" y="35" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="asAsync().invoker(...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=9;fontColor=#047857;" edge="1" parent="1" source="stage1" target="stage_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="Lazy Trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=9;fontColor=#047857;" edge="1" parent="1" source="stage_db" target="stage2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>